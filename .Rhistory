library(lme4)
library(here)
source(file.path(here(), "src", "R", "auxiliary", "workflow.R"))
source(file.path(here(), "src", "R", "auxiliary", "helper.R"))
source(file.path(here(), "src", "R", "auxiliary", "test_helper.R"))
rand_a <- get_test_model_package("a")
rand_b <- get_test_model_package("b")
rand_both <- get_test_model_package("both")
temp_list = list(rand_a = rand_a, rand_b = rand_b, rand_both = rand_both)
for (random_pack in names(temp_list)) {
cat("============== Results for", random_pack, "==============\n")
all_exps <- temp_list[[random_pack]]
for (model_pack in names(all_exps)) {
cat("------------ Experiment:", model_pack, "------------\n")
model_pack <- all_exps[[model_pack]]
models <- model_pack$models
for (dim in dimensions) {
cat("Dimension:", dim, "\n")
aic <- AIC(models[[dim]])
bic <- BIC(models[[dim]])
cat("Model AIC for", dim, ":", aic, "\n")
cat("Model BIC for", dim, ":", bic, "\n")
}
}
}
