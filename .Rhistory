# 创建数据框
df <- data.frame(
ID = 1:4,
Name = names,
Age = c(25, 30, 35, 28),
Score = c(85, 92, 78, 88)
)
# 应用函数
df$Grade <- sapply(df$Score, calculate_grade)
# 保存图表到文件
png("age_score_plot.png", width = 800, height = 600)
# 创建散点图
plot(df$Age, df$Score,
main = "年龄与分数关系图",
xlab = "年龄",
ylab = "分数",
pch = 19,
col = "blue")
