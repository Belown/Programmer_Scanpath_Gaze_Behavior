# 简单的R数据分析示例
# 加载必要的库
library(ggplot2)
install.packages("ggplot2")
library(dplyr)
install.packages("dplyr")
# 创建示例数据集
set.seed(123)
data <- data.frame(
x = rnorm(100, mean = 50, sd = 15),
y = rnorm(100, mean = 30, sd = 10),
category = sample(c("A", "B", "C"), 100, replace = TRUE)
)
# 查看数据结构
print("数据结构:")
str(data)
# 基本统计摘要
print("数据摘要:")
summary(data)
# 按类别分组的统计
print("按类别分组的统计:")
data %>%
group_by(category) %>%
summarise(
mean_x = mean(x),
mean_y = mean(y),
count = n()
)
# 简单的R数据分析示例
# 加载必要的库
library(ggplot2)
library(dplyr)
# 创建示例数据集
set.seed(123)
data <- data.frame(
x = rnorm(100, mean = 50, sd = 15),
y = rnorm(100, mean = 30, sd = 10),
category = sample(c("A", "B", "C"), 100, replace = TRUE)
)
# 查看数据结构
print("数据结构:")
str(data)
# 基本统计摘要
print("数据摘要:")
summary(data)
# 按类别分组的统计
print("按类别分组的统计:")
data %>%
group_by(category) %>%
summarise(
mean_x = mean(x),
mean_y = mean(y),
count = n()
)
# 创建散点图
plot1 <- ggplot(data, aes(x = x, y = y, color = category)) +
geom_point(size = 3, alpha = 0.7) +
labs(
title = "散点图示例",
x = "X变量",
y = "Y变量",
color = "类别"
) +
theme_minimal()
# 显示图形
print(plot1)
# 创建箱线图
plot2 <- ggplot(data, aes(x = category, y = x, fill = category)) +
geom_boxplot() +
labs(
title = "箱线图示例",
x = "类别",
y = "X变量值"
) +
theme_minimal()
print(plot2)
# 简单的线性回归
model <- lm(y ~ x, data = data)
print("线性回归结果:")
summary(model)
# 保存数据到CSV文件
write.csv(data, "sample_data.csv", row.names = FALSE)
print("数据已保存到 sample_data.csv")
View(data)
View(data)
View(model)
data %>%
group_by(category) %>%
summarise(
mean_x = mean(x),
mean_y = mean(y),
count = n()
)
source("D:/Storage/ETH/Thesis/Code/src/Tools/analysis_R/test.R", echo = TRUE)
# 显示图形
plot1
dev.off()
ls
# 简单的R数据分析示例
# 加载必要的库
library(ggplot2)
library(dplyr)
# 创建示例数据集
set.seed(123)
data <- data.frame(
x = rnorm(100, mean = 50, sd = 15),
y = rnorm(100, mean = 30, sd = 10),
category = sample(c("A", "B", "C"), 100, replace = TRUE)
)
# 查看数据结构
print("数据结构:")
str(data)
# 基本统计摘要
print("数据摘要:")
summary(data)
# 按类别分组的统计
print("按类别分组的统计:")
data %>%
group_by(category) %>%
summarise(
mean_x = mean(x),
mean_y = mean(y),
count = n()
)
# 创建散点图
plot1 <- ggplot(data, aes(x = x, y = y, color = category)) +
geom_point(size = 3, alpha = 0.7) +
labs(
title = "散点图示例",
x = "X变量",
y = "Y变量",
color = "类别"
) +
theme_minimal()
# 显示图形
print(plot1)
# 创建箱线图
plot2 <- ggplot(data, aes(x = category, y = x, fill = category)) +
geom_boxplot() +
labs(
title = "箱线图示例",
x = "类别",
y = "X变量值"
) +
theme_minimal()
print(plot2)
# 简单的线性回归
model <- lm(y ~ x, data = data)
print("线性回归结果:")
summary(model)
# 保存数据到CSV文件
write.csv(data, "sample_data.csv", row.names = FALSE)
print("数据已保存到 sample_data.csv")
