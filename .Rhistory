mutate(
expertise_a = factor(expertise_a,
levels = c("none", "low", "medium", "high"),
ordered = TRUE),
across(c(exp_a, exp_b), as.factor)
)
df$Shape <- scale(df$Shape, center = TRUE, scale = TRUE)
