within_trial_within_5 <- get_model_pack("within_trial", "EMIP_corrected", "within_group", "trial_5", "mean_diff")
within_trial_between_2 <- get_model_pack("within_trial", "EMIP_corrected", "between_group", "trial_2", "mean_diff")
within_trial_between_5 <- get_model_pack("within_trial", "EMIP_corrected", "between_group", "trial_5", "mean_diff")
within_group <- get_model_pack("within_group", "EMIP_corrected", "", "", "")
between_group <- get_model_pack("between_group", "EMIP_corrected", "", "", "mean_diff")
model_package_list <- c(
within_trial_within_2,
within_trial_within_5,
within_trial_between_2,
within_trial_between_5,
within_group,
between_group
)
for (model_pack in model_package_list) {
folder_path <- model_pack$folder_path
dataframe <- model_pack$data
