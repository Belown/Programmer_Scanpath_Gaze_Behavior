tidy(mod, effects = "fixed") %>%
mutate(
signif = case_when(
p.value < 0.001 ~ "***",
p.value < 0.01  ~ "**",
p.value < 0.05  ~ "*",
p.value < 0.1   ~ ".",
TRUE            ~ ""
),
