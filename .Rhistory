# order the two expertise levels to ensure symmetry
Exp_min = if_else(
as.numeric(ExpertiseA) <= as.numeric(ExpertiseB),
as.character(ExpertiseA),
as.character(ExpertiseB)
),
Exp_max = if_else(
as.numeric(ExpertiseA) <= as.numeric(ExpertiseB),
